#include <Wire.h>
#include <Adafruit_BMP280.h>
#include <Servo.h>
#include <EEPROM.h>

// =================== НАСТРОЙКИ (МЕНЯЙ ЗДЕСЬ) ===================
const float GROUND_ALTITUDE     = 140.0;   // высота твоей стартовой площадки над уровнем моря
const float IGNITION_ALTITUDE   = 300.0;   // высота, на которой зажигается RD-50
const float LIFTOFF_THRESHOLD   = 20.0;    // высота, при которой фиксируем старт

const int SERVO_SEPARATION_ANGLE = 90;     // угол поворота двух серво для отделения ступени
const int SERVO_PARACHUTE_ANGLE  = 180;    // угол поворота серво для раскрытия парашюта

const int PIN_SERVO_SEP1         = 9;
const int PIN_SERVO_SEP2         = 10;
const int PIN_SERVO_PARACHUTE    = 11;
const int PIN_RELAY              = 7;      // реле → электрозапал
const int PIN_REPORT_BUTTON      = 2;      // замыкаем на GND для вывода отчёта после полёта

const unsigned long IGNITER_BURN_TIME = 2000; // 2 секунды горения запала

// Адреса в EEPROM
#define ADDR_STATUS              0   // 1 байт: 0 = не летали, 1 = полёт завершён
#define ADDR_LIFTOFF_ALT        10   // float
#define ADDR_LIFTOFF_TIME       14   // unsigned long
#define ADDR_IGNITION_ALT       18
#define ADDR_IGNITION_TIME      22
#define ADDR_SEPARATION_ALT     26
#define ADDR_SEPARATION_TIME    30
#define ADDR_APOGEE_ALT         34
#define ADDR_PARACHUTE_ALT      38
#define ADDR_PARACHUTE_TIME     42
// ==============================================================

Adafruit_BMP280 bmp;
Servo servoSep1, servoSep2, servoParachute;

float baselinePressure = 0;

bool liftoffRecorded   = false;
bool engineIgnited     = false;
bool stageSeparated    = false;
bool parachuteDeployed = false;

unsigned long ignitionTime = 0;

void setup() {
  pinMode(PIN_REPORT_BUTTON, INPUT_PULLUP);

  // === Если при включении пин 2 замкнут на GND — выводим отчёт и/или чистим память ===
  if (digitalRead(PIN_REPORT_BUTTON) == LOW) {
    printFlightReportAndClear();
    while(1); // зависаем, чтобы не начинать полёт
  }

  pinMode(PIN_RELAY, OUTPUT);
  digitalWrite(PIN_RELAY, LOW);

  servoSep1.attach(PIN_SERVO_SEP1);
  servoSep2.attach(PIN_SERVO_SEP2);
  servoParachute.attach(PIN_SERVO_PARACHUTE);
  servoSep1.write(0);
  servoSep2.write(0);
  servoParachute.write(0);

  // BMP280 — автоматически ищет оба адреса 0x76 и 0x77
  if (!bmp.begin()) {
    while(1); // ошибка датчика — просто зависаем (без писка)
  }

  // Калибровка давления на земле (10 секунд)
  baselinePressure = 0;
  for (int i = 0; i < 100; i++) {
    baselinePressure += bmp.readPressure();
    delay(100);
  }
  baselinePressure /= 100.0;

  // Если уже летали — больше ничего не делаем
  if (EEPROM.read(ADDR_STATUS) == 1) {
    while(1) delay(1000);
  }
}

void loop() {
  if (EEPROM.read(ADDR_STATUS) == 1) return; // полёт уже завершён

  float currentAltitude = bmp.readAltitude(baselinePressure) - GROUND_ALTITUDE;

  // 0. Фиксация старта ракеты
  if (!liftoffRecorded && currentAltitude >= LIFTOFF_THRESHOLD) {
    EEPROM.put(ADDR_LIFTOFF_ALT, currentAltitude);
    EEPROM.put(ADDR_LIFTOFF_TIME, millis());
    liftoffRecorded = true;
  }

  // 1. Зажигание двигателя второй ступени
  if (!engineIgnited && currentAltitude >= IGNITION_ALTITUDE) {
    digitalWrite(PIN_RELAY, HIGH);
    ignitionTime = millis();
    EEPROM.put(ADDR_IGNITION_ALT, currentAltitude);
    EEPROM.put(ADDR_IGNITION_TIME, ignitionTime);
    engineIgnited = true;

    delay(IGNITER_BURN_TIME);
    digitalWrite(PIN_RELAY, LOW);
  }

  // 2. Отделение первой ступени
  if (engineIgnited && !stageSeparated && millis() - ignitionTime > IGNITER_BURN_TIME + 500) {
    servoSep1.write(SERVO_SEPARATION_ANGLE);
    servoSep2.write(SERVO_SEPARATION_ANGLE);
    EEPROM.put(ADDR_SEPARATION_ALT, currentAltitude);
    EEPROM.put(ADDR_SEPARATION_TIME, millis());
    stageSeparated = true;
  }

  // 3. Определение апогея и раскрытие парашюта
  static float previousAltitude = currentAltitude;
  static unsigned long lastAscentTime = millis();
  static float maxAltitude = currentAltitude;

  if (currentAltitude > maxAltitude) {
    maxAltitude = currentAltitude;
    lastAscentTime = millis();
  }

  if (millis() - lastAscentTime > 800 && stageSeparated && !parachuteDeployed) {
    servoParachute.write(SERVO_PARACHUTE_ANGLE);
    EEPROM.put(ADDR_APOGEE_ALT, maxAltitude);
    EEPROM.put(ADDR_PARACHUTE_ALT, maxAltitude);
    EEPROM.put(ADDR_PARACHUTE_TIME, millis());
    EEPROM.write(ADDR_STATUS, 1);        // ПОЛЁТ ЗАВЕРШЁН
    parachuteDeployed = true;
  }

  previousAltitude = currentAltitude;
  delay(50);
}

// ===================== ВЫВОД ОТЧЁТА ПОСЛЕ ПОЛЁТА =====================
void printFlightReportAndClear() {
  Serial.begin(115200);
  while (!Serial) delay(10);
  delay(1000);

  Serial.println(F("\n=== ОТЧЁТ О ПОЛЁТЕ ВТОРОЙ СТУПЕНИ ==="));

  if (EEPROM.read(ADDR_STATUS) != 1) {
    Serial.println(F("Полёт не был выполнен или данные стёрты."));
    Serial.println(F("Для очистки памяти удерживай пин 2 на GND и нажми RESET ещё раз."));
    return;
  }

  float liftoffAlt, ignAlt, sepAlt, apogeeAlt, paraAlt;
  unsigned long liftoffT = 0, ignT = 0, sepT = 0, paraT = 0;

  EEPROM.get(ADDR_LIFTOFF_ALT, liftoffAlt);
  EEPROM.get(ADDR_LIFTOFF_TIME, liftoffT);
  EEPROM.get(ADDR_IGNITION_ALT, ignAlt);
  EEPROM.get(ADDR_IGNITION_TIME, ignT);
  EEPROM.get(ADDR_SEPARATION_ALT, sepAlt);
  EEPROM.get(ADDR_SEPARATION_TIME, sepT);
  EEPROM.get(ADDR_APOGEE_ALT, apogeeAlt);
  EEPROM.get(ADDR_PARACHUTE_TIME, paraT);

  unsigned long startTime = liftoffT > 100 ? liftoffT : ignT;

  Serial.print(F("Старт (liftoff):          ")); Serial.print(liftoffAlt, 1); Serial.println(F(" м"));
  Serial.print(F("Зажигание двигателя:      ")); Serial.print(ignAlt, 1); Serial.print(F(" м   (+")); Serial.print((ignT - startTime)/1000.0, 2); Serial.println(F(" с)"));
  Serial.print(F("Отделение ступени:        ")); Serial.print(sepAlt, 1); Serial.print(F(" м   (+")); Serial.print((sepT - startTime)/1000.0, 2); Serial.println(F(" с)"));
  Serial.print(F("Апогей:                   ")); Serial.print(apogeeAlt, 1); Serial.println(F(" м"));
  Serial.print(F("Раскрытие парашюта:       ")); Serial.print(apogeeAlt, 1); Serial.print(F(" м   (+")); Serial.print((paraT - startTime)/1000.0, 2); Serial.println(F(" с)"));

  Serial.println(F("\n======================================="));
  Serial.println(F("Для очистки памяти — удерживай пин 2 на GND"));
  Serial.println(F("и нажми RESET ещё раз."));

  // Очистка памяти при двойном замыкании пина 2
  if (digitalRead(PIN_REPORT_BUTTON) == LOW) {
    for (int i = 0; i < EEPROM.length(); i++) EEPROM.write(i, 0xFF);
    Serial.println(F("ПАМЯТЬ ОЧИЩЕНА! Теперь можно лететь снова."));
  }
}
