#include <Wire.h>
#include <Adafruit_BMP280.h>
#include <Servo.h>
#include <EEPROM.h>

// =================== НАСТРОЙКИ ===================
const float GROUND_ALTITUDE = 140.0;        // высота стартовой площадки над уровнем моря
const float IGNITION_ALTITUDE = 300.0;       // высота зажигания RD-50
const float LIFTOFF_THRESHOLD = 20.0;        // высота, при которой фиксируем старт полёта (м)

const int SERVO_SEPARATION_ANGLE = 90;       // угол отделения
const int SERVO_PARACHUTE_ANGLE  = 180;     // угол раскрытия парашюта

const int PIN_SERVO_SEP1      = 9;
const int PIN_SERVO_SEP2      = 10;
const int PIN_SERVO_PARACHUTE = 11;
const int PIN_RELAY           = 7;
const int PIN_PIEZO           = 8;           // можно подключить пьезопищалку для звуковых сигналов (опционально)

const unsigned long IGNITER_BURN_TIME = 2000; // 2 секунды горения запала

// Адреса в EEPROM
#define ADDR_STATUS              0   // 1 байт: 0 = не летали, 1 = полёт завершён
#define ADDR_LIFTOFF_ALT        10   // float
#define ADDR_LIFTOFF_TIME       14   // unsigned long
#define ADDR_IGNITION_ALT       18   // float
#define ADDR_IGNITION_TIME      22   // unsigned long
#define ADDR_SEPARATION_ALT     26   // float
#define ADDR_SEPARATION_TIME    30   // unsigned long
#define ADDR_APOGEE_ALT         34   // float
#define ADDR_PARACHUTE_ALT      38   // float (то же, что и апогей)
#define ADDR_PARACHUTE_TIME     42   // unsigned long
// ===============================================

Adafruit_BMP280 bmp;
Servo servoSep1, servoSep2, servoParachute;

float baselinePressure = 0;

bool liftoffRecorded = false;
bool engineIgnited = false;
bool stageSeparated = false;
bool parachuteDeployed = false;

void beep(int count = 1, int duration = 200) {
  for(int i = 0; i < count; i++) {
    digitalWrite(PIN_PIEZO, HIGH); delay(duration); digitalWrite(PIN_PIEZO, LOW); delay(duration);
  }
}

void setup() {
  pinMode(PIN_PIEZO, OUTPUT);
  
  // Если пин 2 заземлён при включении — выводим отчёт
  pinMode(2, INPUT_PULLUP);
  if (digitalRead(2) == LOW) {
    printFlightReportAndClear();
    while(1) delay(100);
  }

  pinMode(PIN_RELAY, OUTPUT);
  digitalWrite(PIN_RELAY, LOW);

  servoSep1.attach(PIN_SERVO_SEP1);
  servoSep2.attach(PIN_SERVO_SEP2);
  servoParachute.attach(PIN_SERVO_PARACHUTE);
  servoSep1.write(0);
  servoSep2.write(0);
  servoParachute.write(0);

  if (!bmp.begin(0x76)) {  // или 0x77
    // мигаем как сумасшедшие — датчик не найден
    pinMode(PIN_PIEZO, OUTPUT);
    while(1) { beep(3, 100); delay(500); }
  }

  // Калибровка 10 секунд
  baselinePressure = 0;
  for (int i = 0; i < 100; i++) {
    baselinePressure += bmp.readPressure();
    delay(100);
  }
  baselinePressure /= 100.0;

  // Если уже летали — больше ничего не делаем
  if (EEPROM.read(ADDR_STATUS) == 1) {
    while(1) delay(1000);
  }
}

void loop() {
  if (EEPROM.read(ADDR_STATUS) == 1) {
    delay(1000);
    return; // полёт уже был — ничего не делаем
  }

  float pressure = bmp.readPressure();
  float currentAltitude = bmp.readAltitude(baselinePressure) - GROUND_ALTITUDE;

  // === 0. Фиксация старта полёта (liftoff) ===
  if (!liftoffRecorded && currentAltitude >= LIFTOFF_THRESHOLD) {
    EEPROM.put(ADDR_LIFTOFF_ALT, currentAltitude);
    EEPROM.put(ADDR_LIFTOFF_TIME, millis());
    liftoffRecorded = true;
    // beep(2, 150);   // опционально — два коротких сигнала при старте
  }

  // === 1. Зажигание двигателя ===
  if (!engineIgnited && currentAltitude >= IGNITION_ALTITUDE) {
    digitalWrite(PIN_RELAY, HIGH);
    EEPROM.put(ADDR_IGNITION_ALT, currentAltitude);
    EEPROM.put(ADDR_IGNITION_TIME, millis());
    engineIgnited = true;
    // beep(1, 800);   // длинный сигнал — зажигание

    delay(IGNITER_BURN_TIME);
    digitalWrite(PIN_RELAY, LOW);
  }

  // === 2. Отделение ступени ===
  if (engineIgnited && !stageSeparated && millis() - EEPROM.get(ADDR_IGNITION_TIME, ignitionTime) > IGNITER_BURN_TIME + 500) {
    servoSep1.write(SERVO_SEPARATION_ANGLE);
    servoSep2.write(SERVO_SEPARATION_ANGLE);
    EEPROM.put(ADDR_SEPARATION_ALT, currentAltitude);
    EEPROM.put(ADDR_SEPARATION_TIME, millis());
    stageSeparated = true;
    // beep(3, 100);
  }

  // === 3. Апогей → раскрытие парашюта ===
  static float previousAltitude = currentAltitude;
  static unsigned long lastAscentTime = millis();
  static float maxAltitude = currentAltitude;

  if (currentAltitude > maxAltitude) {
    maxAltitude = currentAltitude;
    lastAscentTime = millis();
  }

  if (millis() - lastAscentTime > 800 && stageSeparated && !parachuteDeployed) {
    servoParachute.write(SERVO_PARACHUTE_ANGLE);
    EEPROM.put(ADDR_APOGEE_ALT, maxAltitude);
    EEPROM.put(ADDR_PARACHUTE_ALT, maxAltitude);
    EEPROM.put(ADDR_PARACHUTE_TIME, millis());
    EEPROM.write(ADDR_STATUS, 1);          // полёт завершён
    parachuteDeployed = true;

    // Финальные сигналы — длинная трель
    beep(10, 200);
  }

  previousAltitude = currentAltitude;
  delay(50);
}

// ====================== ФУНКЦИИ =====================
void saveFloat(int addr, float val) { EEPROM.put(addr, val); }
void saveULong(int addr, unsigned long val) { EEPROM.put(addr, val); }

void printFlightReportAndClear() {
  Serial.begin(115200);
  delay(1000);
  Serial.println(F("=== ОТЧЁТ О ПОЛЁТЕ ВТОРОЙ СТУПЕНИ ==="));

  if (EEPROM.read(ADDR_STATUS) != 1) {
    Serial.println(F("Полёт не выполнен или данные очищены."));
    Serial.println(F("Замкни пин 2 на GND и нажми RESET ещё раз для очистки."));
    return;
  }

  float liftoffAlt, ignAlt, sepAlt, apogeeAlt, paraAlt;
  unsigned long liftoffT = 0, ignT, sepT, paraT;

  EEPROM.get(ADDR_LIFTOFF_TIME, liftoffT);
  EEPROM.get(ADDR_IGNITION_TIME, ignT);
  EEPROM.get(ADDR_SEPARATION_TIME, sepT);
  EEPROM.get(ADDR_PARACHUTE_TIME, paraT);
  EEPROM.get(ADDR_LIFTOFF_ALT, liftoffAlt);
  EEPROM.get(ADDR_IGNITION_ALT, ignAlt);
  EEPROM.get(ADDR_SEPARATION_ALT, sepAlt);
  EEPROM.get(ADDR_APOGEE_ALT, apogeeAlt);
  EEPROM.get(ADDR_PARACHUTE_ALT, paraAlt);

  unsigned long referenceTime = (liftoffT > 10000 ? liftoffT : ignT); // если liftoff не поймали — от зажигания

  Serial.print(F("Старт полёта (liftoff):   ")); Serial.print(liftoffAlt, 1); Serial.print(F(" м  (t = ")); Serial.print(referenceTime / 1000.0, 1); Serial.println(F(" с от включения)"));

  Serial.print(F("Зажигание двигателя:      ")); Serial.print(ignAlt, 1); Serial.print(F(" м  (+")); Serial.print((ignT - referenceTime)/1000.0, 1); Serial.println(F(" с)"));

  Serial.print(F("Отделение ступени:        ")); Serial.print(sepAlt, 1); Serial.print(F(" м  (+")); Serial.print((sepT - referenceTime)/1000.0, 1); Serial.println(F(" с)"));

  Serial.print(F("Апогей:                  ")); Serial.print(apogeeAlt, 1); Serial.println(F(" м"));

  Serial.print(F("Раскрытие парашюта:       ")); Serial.print(paraAlt, 1); Serial.print(F(" м  (+")); Serial.print((paraT - referenceTime)/1000.0, 1); Serial.println(F(" с)"));

  Serial.println(F("==================================="));
  Serial.println(F("Для очистки памяти — зажми пин 2 на GND и нажми RESET"));

  if (digitalRead(2) == LOW) {
    for (int i = 0; i < EEPROM.length(); i++) EEPROM.write(i, 0xFF);
    Serial.println(F("ПАМЯТЬ ОЧИЩЕНА!"));
  }
}
