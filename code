#include <Wire.h>
#include <Adafruit_BMP280.h>
#include <Servo.h>
#include <EEPROM.h>

// =================== НАСТРОЙКИ ===================
const float GROUND_ALTITUDE = 140.0;
const float IGNITION_ALTITUDE = 300.0;
const float LIFTOFF_THRESHOLD = 20.0;

const int SERVO_SEPARATION_ANGLE = 90;
const int SERVO_PARACHUTE_ANGLE  = 180;

const int PIN_SERVO_SEP1      = 9;
const int PIN_SERVO_SEP2      = 10;
const int PIN_SERVO_PARACHUTE = 11;
const int PIN_RELAY           = 7;
const int PIN_PIEZO           = 8;

const unsigned long IGNITER_BURN_TIME = 2000;

// Адреса в EEPROM (те же самые)
#define ADDR_STATUS              0
#define ADDR_LIFTOFF_ALT        10
#define ADDR_LIFTOFF_TIME       14
#define ADDR_IGNITION_ALT       18
#define ADDR_IGNITION_TIME      22
#define ADDR_SEPARATION_ALT     26
#define ADDR_SEPARATION_TIME    30
#define ADDR_APOGEE_ALT         34
#define ADDR_PARACHUTE_ALT      38
#define ADDR_PARACHUTE_TIME     42
// ===============================================

Adafruit_BMP280 bmp;
Servo servoSep1, servoSep2, servoParachute;

float baselinePressure = 0;

bool liftoffRecorded = false;
bool engineIgnited = false;
bool stageSeparated = false;
bool parachuteDeployed = false;

// ←←←←←←←←←←←←←←←←←←←← ЭТУ СТРОКУ Я ЗАБЫЛ ДОБАВИТЬ РАНЬШЕ
unsigned long ignitionTime = 0;   // теперь всё будет работать

void beep(int count = 1, int duration = 200) {
  for(int i = 0; i < count; i++) {
    digitalWrite(PIN_PIEZO, HIGH); delay(duration);
    digitalWrite(PIN_PIEZO, LOW);  delay(duration);
  }
}

void setup() {
  pinMode(PIN_PIEZO, OUTPUT);
  pinMode(2, INPUT_PULLUP);
  if (digitalRead(2) == LOW) {
    printFlightReportAndClear();
    while(1);
  }

  pinMode(PIN_RELAY, OUTPUT);
  digitalWrite(PIN_RELAY, LOW);

  servoSep1.attach(PIN_SERVO_SEP1);
  servoSep2.attach(PIN_SERVO_SEP2);
  servoParachute.attach(PIN_SERVO_PARACHUTE);
  servoSep1.write(0);
  servoSep2.write(0);
  servoParachute.write(0);

  if (!bmp.begin()) {               // автоматически ищет 0x76 и 0x77
    while(1) { beep(3,100); delay(500); }
  }

  baselinePressure = 0;
  for (int i = 0; i < 100; i++) {
    baselinePressure += bmp.readPressure();
    delay(100);
  }
  baselinePressure /= 100.0;

  if (EEPROM.read(ADDR_STATUS) == 1) while(1);
}

void loop() {
  if (EEPROM.read(ADDR_STATUS) == 1) return;

  float currentAltitude = bmp.readAltitude(baselinePressure) - GROUND_ALTITUDE;

  // 0. Liftoff
  if (!liftoffRecorded && currentAltitude >= LIFTOFF_THRESHOLD) {
    EEPROM.put(ADDR_LIFTOFF_ALT, currentAltitude);
    EEPROM.put(ADDR_LIFTOFF_TIME, millis());
    liftoffRecorded = true;
  }

  // 1. Зажигание двигателя
  if (!engineIgnited && currentAltitude >= IGNITION_ALTITUDE) {
    digitalWrite(PIN_RELAY, HIGH);
    ignitionTime = millis();                     // сохраняем в переменную
    EEPROM.put(ADDR_IGNITION_ALT, currentAltitude);
    EEPROM.put(ADDR_IGNITION_TIME, ignitionTime);
    engineIgnited = true;

    delay(IGNITER_BURN_TIME);
    digitalWrite(PIN_RELAY, LOW);
  }

  // 2. Отделение ступени — ИСПРАВЛЕНО!
  if (engineIgnited && !stageSeparated && millis() - ignitionTime > IGNITER_BURN_TIME + 500) {
    servoSep1.write(SERVO_SEPARATION_ANGLE);
    servoSep2.write(SERVO_SEPARATION_ANGLE);
    EEPROM.put(ADDR_SEPARATION_ALT, currentAltitude);
    EEPROM.put(ADDR_SEPARATION_TIME, millis());
    stageSeparated = true;
  }

  // 3. Апогей и парашют
  static float previousAltitude = currentAltitude;
  static unsigned long lastAscentTime = millis();
  static float maxAltitude = currentAltitude;

  if (currentAltitude > maxAltitude) {
    maxAltitude = currentAltitude;
    lastAscentTime = millis();
  }

  if (millis() - lastAscentTime > 800 && stageSeparated && !parachuteDeployed) {
    servoParachute.write(SERVO_PARACHUTE_ANGLE);
    EEPROM.put(ADDR_APOGEE_ALT, maxAltitude);
    EEPROM.put(ADDR_PARACHUTE_ALT, maxAltitude);
    EEPROM.put(ADDR_PARACHUTE_TIME, millis());
    EEPROM.write(ADDR_STATUS, 1);
    parachuteDeployed = true;
    beep(10, 200);
  }

  previousAltitude = currentAltitude;
  delay(50);
}

