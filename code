#include <Servo.h>
#include <DHT.h>

// Пины устройств
const int led1 = 2;
const int led2 = 3;
const int led3 = 4;
const int led4 = 5;
const int servo1Pin = 8;
const int servo2Pin = 9;
const int relayPin = A0;

// Датчик DHT11
#define DHTPIN 6      // Пин DATA датчика DHT11
#define DHTTYPE DHT11 // Тип датчика
DHT dht(DHTPIN, DHTTYPE); // Создаем объект датчика

// Структура для хранения данных с привязкой к этапу
struct SensorData {
  unsigned long timeStamp;  // Время срабатывания этапа
  int stepNumber;           // Номер этапа (1, 2, 3)
  float temperature;        // Температура в момент этапа
  float humidity;           // Влажность в момент этапа
};

// Массив для хранения данных (последние 10 измерений)
SensorData sensorLog[10];
int logIndex = 0;

Servo servo1;
Servo servo2;

// Переменные для хранения времени
unsigned long startTime = 0;
unsigned long currentTime = 0;
bool programStarted = false;
bool programCompleted = false;

// Флаги выполненных шагов
bool step1Done = false;
bool step2Done = false;
bool step3Done = false;

void setup() {
  Serial.begin(9600);
  
  // Инициализация устройств
  pinMode(led1, OUTPUT);
  pinMode(led2, OUTPUT);
  pinMode(led3, OUTPUT);
  pinMode(led4, OUTPUT);
  pinMode(relayPin, OUTPUT);
  
  servo1.attach(servo1Pin);
  servo2.attach(servo2Pin);
  
  // Инициализация DHT11
  dht.begin();
  delay(1000); // Даем датчику время на инициализацию
  
  // Начальное состояние
  resetDevices();
  
  startTime = millis();
  programStarted = true;
  programCompleted = false;
  
  Serial.println(F("==="));
  printHelp();
}

void loop() {
  if (!programStarted) return;
  
  currentTime = millis() - startTime;
  
  if (!programCompleted) {
    checkSchedule();
  }
  
  if (Serial.available()) {
    handleCommand();
  }
  
  delay(50);
}

void handleCommand() {
  String command = Serial.readString();
  command.trim();
  
  if (command == "info") {
    printAllData();
  }
  else if (command == "restart") {
    resetProgram();
  }
  else if (command == "clean") {
    clearSensorLog();
  }
  else if (command == "help") {
    printHelp();
  }
  else if (command == "sensors") {
    printSensorLog();  // Вывод всех сохраненных данных с датчика
  }
}

void checkSchedule() {
  if (!step1Done && currentTime >= 20000) {
    executeStep1();
    step1Done = true;
  }
  else if (!step2Done && currentTime >= 30000) {
    executeStep2();
    step2Done = true;
  }
  else if (!step3Done && currentTime >= 35000) {
    executeStep3();
    step3Done = true;
    programCompleted = true;
  }
}

void executeStep1() {
  digitalWrite(led1, LOW);
  digitalWrite(led2, HIGH);
  servo1.write(90);
  Serial.println(F(">>> 20сек: LED2, Servo1 90°, LED1 выкл"));
  
  // Считываем данные с DHT11 после срабатывания этапа
  delay(100); // Небольшая задержка для стабилизации
  readAndSaveSensorData(1);
}

void executeStep2() {
  digitalWrite(led2, LOW);
  digitalWrite(led3, HIGH);
  digitalWrite(relayPin, HIGH);
  Serial.println(F(">>> 30сек: LED3, LED2 выкл, реле ВКЛ"));
  
  // Считываем данные с DHT11 после срабатывания этапа
  delay(100);
  readAndSaveSensorData(2);
}

void executeStep3() {
  digitalWrite(led3, LOW);
  digitalWrite(led4, HIGH);
  servo2.write(90);
  Serial.println(F(">>> 35сек: LED4, Servo2 90°, LED3 выкл"));
  
  // Считываем данные с DHT11 после срабатывания этапа
  delay(100);
  readAndSaveSensorData(3);
}

void readAndSaveSensorData(int stepNum) {
  // Даем датчику дополнительное время для подготовки
  delay(2000); // DHT11 требует минимум 2 секунды между измерениями
  
  float h = dht.readHumidity();
  float t = dht.readTemperature();
  
  // Проверяем, успешно ли прошло чтение
  if (isnan(h) || isnan(t)) {
    Serial.print(F("Ошибка чтения DHT11 на этапе "));
    Serial.println(stepNum);
    
    // Сохраняем данные с отметкой об ошибке
    sensorLog[logIndex].timeStamp = currentTime;
    sensorLog[logIndex].stepNumber = stepNum;
    sensorLog[logIndex].temperature = -99.9;  // Значение для ошибки
    sensorLog[logIndex].humidity = -99.9;     // Значение для ошибки
  } else {
    // Сохраняем успешные данные
    sensorLog[logIndex].timeStamp = currentTime;
    sensorLog[logIndex].stepNumber = stepNum;
    sensorLog[logIndex].temperature = t;
    sensorLog[logIndex].humidity = h;
    
    Serial.print(F("DHT11 - Этап "));
    Serial.print(stepNum);
    Serial.print(F(": T="));
    Serial.print(t);
    Serial.print(F("°C, H="));
    Serial.print(h);
    Serial.println(F("%"));
  }
  
  // Переходим к следующей ячейке в логе (циклический буфер)
  logIndex = (logIndex + 1) % 10;
}

void printAllData() {
  Serial.println(F("==="));
  printCurrentState();
  Serial.println(F("--- ДАННЫЕ СЕНСОРОВ ---"));
  printSensorLog();
  Serial.println(F("==="));
}

void printCurrentState() {
  Serial.println(F("==="));
  Serial.print(F("LED1: ")); Serial.println(digitalRead(led1) ? "ВКЛ" : "ВЫКЛ");
  Serial.print(F("LED2: ")); Serial.println(digitalRead(led2) ? "ВКЛ" : "ВЫКЛ");
  Serial.print(F("LED3: ")); Serial.println(digitalRead(led3) ? "ВКЛ" : "ВЫКЛ");
  Serial.print(F("LED4: ")); Serial.println(digitalRead(led4) ? "ВКЛ" : "ВЫКЛ");
  Serial.print(F("Реле: ")); Serial.println(digitalRead(relayPin) ? "ВКЛ" : "ВЫКЛ");
  Serial.print(F("Servo1: ")); Serial.print(servo1.read()); Serial.println(F("°"));
  Serial.print(F("Servo2: ")); Serial.print(servo2.read()); Serial.println(F("°"));
  Serial.println(F("==="));
}

void printSensorLog() {
  bool hasData = false;
  
  for (int i = 0; i < 10; i++) {
    int idx = (logIndex - i - 1 + 10) % 10; // Читаем в обратном порядке
    
    if (sensorLog[idx].stepNumber != 0) { // Проверяем, есть ли данные
      hasData = true;
      Serial.print(F("Этап "));
      Serial.print(sensorLog[idx].stepNumber);
      Serial.print(F(" (T+"));
      Serial.print(sensorLog[idx].timeStamp / 1000);
      Serial.print(F("с): "));
      
      if (sensorLog[idx].temperature == -99.9) {
        Serial.println(F("Ошибка чтения датчика"));
      } else {
        Serial.print(F("T="));
        Serial.print(sensorLog[idx].temperature);
        Serial.print(F("°C, H="));
        Serial.print(sensorLog[idx].humidity);
        Serial.println(F("%"));
      }
    }
  }
  
  if (!hasData) {
    Serial.println(F("Нет данных с датчиков"));
  }
}

void clearSensorLog() {
  // Очищаем лог сенсоров
  for (int i = 0; i < 10; i++) {
    sensorLog[i].stepNumber = 0;
    sensorLog[i].temperature = 0;
    sensorLog[i].humidity = 0;
    sensorLog[i].timeStamp = 0;
  }
  logIndex = 0;
  Serial.println(F("Лог датчиков очищен"));
}

void resetDevices() {
  digitalWrite(led1, HIGH);
  digitalWrite(led2, LOW);
  digitalWrite(led3, LOW);
  digitalWrite(led4, LOW);
  digitalWrite(relayPin, LOW);
  servo1.write(0);
  servo2.write(0);
}

void resetProgram() {
  resetDevices();
  startTime = millis();
  currentTime = 0;
  programCompleted = false;
  step1Done = false;
  step2Done = false;
  step3Done = false;
  Serial.println(F("Программа перезапущена"));
}

void printHelp() {
  Serial.println(F("==="));
  Serial.println(F("info     - полная информация"));
  Serial.println(F("sensors  - данные с датчиков"));
  Serial.println(F("restart  - перезапуск программы"));
  Serial.println(F("clean    - очистка лога датчиков"));
  Serial.println(F("help     - справка"));
  Serial.println(F("==="));
}
